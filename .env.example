# Copy to .env (never commit .env). Without any of this, every model is a local mock (keyword rules).

# --- keys -------------------------------------------------------------------------------------------------------
OPENROUTER_API_KEY=

# --- small model = the LoRA, served by Ollama (before fine-tuning: its base model, e.g. qwen2.5:3b) ---------------
SMALL_PROVIDER=ollama
SMALL_MODEL=fluxo-support-lora
# SMALL_BASE_URL=http://localhost:11434/v1
# SMALL_PRICE_IN=0          # USD per million tokens; 0 for local inference
# SMALL_PRICE_OUT=0

# --- large model (fallback for risky tickets) ----------------------------------------------------------------------
LARGE_PROVIDER=openrouter
LARGE_MODEL=deepseek/deepseek-v4.1-flash
LARGE_PRICE_IN=0.033
LARGE_PRICE_OUT=0.080

# --- judge (a different model family than the generators) ----------------------------------------------------------
JUDGE_PROVIDER=openrouter
JUDGE_MODEL=google/gemini-2.5-flash
JUDGE_PRICE_IN=0.30
JUDGE_PRICE_OUT=2.50

# --- behaviour -----------------------------------------------------------------------------------------------------
LLM_MODE=live               # live | record | replay
TRIAGE_SAMPLES=2            # self-consistency samples (confidence = agreement)
ROUTE_CONFIDENCE=0.75       # calibrate: eval/calibrate.py router
CACHE_ENABLED=1
CACHE_THRESHOLD=0.92        # calibrate: eval/calibrate.py cache
EMBEDDER=hashing            # hashing | e5 (needs the `embeddings` extra)
HUMAN_IN_THE_LOOP=0         # 1 = escalations pause for a human (CLI / Studio)
MCP_TRANSPORT=inprocess     # inprocess | stdio
